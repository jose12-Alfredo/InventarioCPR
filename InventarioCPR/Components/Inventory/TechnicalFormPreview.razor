@using InventarioCPR.Application.Inventory
@using InventarioCPR.Application.Photos
@using System.Globalization
@using Microsoft.JSInterop
@inject InventoryService Inventory
@inject IJSRuntime JS
@implements IAsyncDisposable

<section class="inventory-workbench" aria-label="Consulta y registro de equipos">
    <div class="inventory-workbench__layout">
        <div class="inventory-workbench__list" aria-labelledby="inventory-list-title" @ref="listPanel">
            <header class="inventory-workbench__toolbar">
                <div class="inventory-workbench__heading">
                    <div>
                        <h2 id="inventory-list-title">@(showDrafts ? "Borradores de equipos" : "Equipos registrados")</h2>
                        <p>@(showDrafts ? "Retome un borrador. No cuenta como equipo definitivo." : "Seleccione un equipo para consultar su expediente.")</p>
                    </div>
                    <div class="inventory-workbench__actions-wrap">
                        <div class="inventory-workbench__buttons">
                            <button type="button" class="btn btn-secondary" title="@WriteRestriction" @onclick="() => OpenNewAsync(true)" disabled="@(!interactiveReady || !canWrite)">Registro rápido</button>
                            <button type="button" class="btn btn-primary" title="@WriteRestriction" @onclick="() => OpenNewAsync(false)" disabled="@(!interactiveReady || !canWrite)"><AppIcon Name="plus-circle" /> Nuevo equipo</button>
                        </div>
                        @if (interactiveReady && !canWrite)
                        {
                            <small class="inventory-workbench__write-note">Creación y edición no disponibles para este perfil o entorno.</small>
                        }
                    </div>
                </div>
                <nav class="registration-list-switch" aria-label="Estado de registro">
                    <button type="button" class="btn btn-secondary" aria-pressed="@(!showDrafts)" disabled="@(!interactiveReady)" @onclick="() => SwitchRegistrationListAsync(false)">Definitivos</button>
                    <button type="button" class="btn btn-secondary" aria-pressed="@showDrafts" disabled="@(!interactiveReady)" @onclick="() => SwitchRegistrationListAsync(true)">Borradores</button>
                </nav>
                <div class="inventory-workbench__filters" role="search" aria-label="Filtrar equipos">
                    <div class="field inventory-workbench__search">
                        <label for="inventory-search">Buscar equipo</label>
                        <span><AppIcon Name="search" /><input id="inventory-search" type="search" placeholder="@(showDrafts ? "Código o nombre del borrador…" : "Código, equipo, marca o modelo…")" disabled="@(!interactiveReady)" @bind="search" @bind:event="oninput" @bind:after="DebouncedRefreshAsync" /></span>
                    </div>
                    <div class="field">
                        <label for="inventory-category">Categoría</label>
                        <select id="inventory-category" disabled="@(!interactiveReady)" @bind="categoryFilter" @bind:after="ApplyFiltersAsync">
                            <option value="">Todas</option><option value="desktop">Computadora de escritorio</option><option value="laptop">Laptop</option><option value="monitor">Monitor</option><option value="camera">Cámara</option><option value="external-disk">Disco externo</option><option value="peripheral">Periférico</option><option value="recording">Equipo de grabación</option><option value="other">Otro dispositivo</option>
                        </select>
                    </div>
                    <div class="field">
                        <label for="inventory-condition">Condición</label>
                        <select id="inventory-condition" disabled="@(!interactiveReady || showDrafts)" @bind="conditionFilter" @bind:after="ApplyFiltersAsync">
                            <option value="">Todas</option><option value="physical">Con condición física</option><option value="operational">Con condición operativa</option><option value="unrecorded">Sin inspección</option>
                            @foreach (var option in conditionOptions) { <option value="@option.Value">@option.Label</option> }
                        </select>
                    </div>
                    <button type="button" class="btn btn-secondary inventory-workbench__clear" disabled="@(!interactiveReady)" @onclick="ClearFiltersAsync">Limpiar</button>
                </div>
            </header>

            @if (error is not null) { <p class="technical-preview__feedback technical-preview__feedback--error" role="alert">@error</p> }
            @if (success is not null) { <p class="technical-preview__feedback" role="status">@success</p> }

            @if (loading)
            {
                <div role="status" class="inventory-workbench__empty"><span class="inventory-workbench__empty-icon"><AppIcon Name="inventory" /></span><strong>Cargando equipos…</strong></div>
            }
            else if (rows.Count == 0)
            {
                <div class="inventory-workbench__empty" role="status"><span class="inventory-workbench__empty-icon"><AppIcon Name="search" /></span><strong>No encontramos equipos</strong><p>Pruebe otra búsqueda o limpie los filtros aplicados.</p></div>
            }
            else
            {
                <div class="inventory-workbench__list-meta"><p class="inventory-workbench__count" role="status">@(total > InventoryService.PageSize ? $"Mostrando {currentPage * InventoryService.PageSize + 1}–{currentPage * InventoryService.PageSize + rows.Count} de {total} {CountLabel(total)}" : $"{total} {CountLabel(total)}")</p><span>Ordenados por código</span></div>
                <div class="inventory-workbench__table-scroll">
                    <table class="inventory-workbench__table">
                        <thead><tr><th scope="col">Foto</th><th scope="col">Código</th><th scope="col">Equipo</th><th scope="col">Categoría</th><th scope="col">Responsable</th><th scope="col">Condición</th><th scope="col">Acciones</th></tr></thead>
                        <tbody>
                            @foreach (var row in rows)
                            {
                                var categoryKey = CategoryKey(row.Category);
                                var isSelected = details?.Id == row.Id;
                                <tr @key="row.Id" data-equipment-id="@row.Id" class="@(isSelected ? "is-selected" : null)" tabindex="0" aria-current="@(isSelected ? "true" : null)" aria-label="@row.Code, @row.Name. Abrir expediente" @onclick="() => OpenAsync(row.Id)" @onkeydown="e => HandleRowKeyDownAsync(e, row.Id)">
                                    <td>
                                        @if (PhotoAvailable(row.PhotoUrl)) { <img class="inventory-workbench__thumbnail" src="@row.PhotoUrl" alt="Fotografía de @row.Name" @onerror="() => MarkPhotoUnavailable(row.PhotoUrl)" /> }
                                        else { <span class="inventory-workbench__thumbnail inventory-workbench__thumbnail--@categoryKey" role="img" aria-label="Sin fotografía disponible"><AppIcon Name="@CategoryIcon(categoryKey)" /></span> }
                                    </td>
                                    <td><strong class="inventory-workbench__code" title="@row.Code">@row.Code</strong></td>
                                    <td><span class="inventory-workbench__equipment"><strong title="@row.Name">@row.Name</strong><small title="@ModelLine(row)">@ModelLine(row)</small></span></td>
                                    <td><span class="inventory-workbench__category" title="@row.Category">@row.Category</span></td>
                                    <td><span class="inventory-workbench__unavailable" title="Las asignaciones de responsables todavía no están habilitadas.">No disponible</span></td>
                                    <td>@PrimaryConditionBadge(row.PhysicalCondition, row.OperationalCondition)</td>
                                    <td><button type="button" class="inventory-workbench__open" disabled="@(!interactiveReady)" aria-current="@(isSelected ? "true" : "false")" @onclick:stopPropagation="true" @onclick="() => OpenAsync(row.Id)">@(showDrafts ? "Retomar borrador" : "Ver expediente")<span class="sr-only"> de @row.Code</span></button></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                <ul class="inventory-workbench__cards">
                    @foreach (var row in rows)
                    {
                        var categoryKey = CategoryKey(row.Category);
                        <li @key="row.Id" class="@(details?.Id == row.Id ? "is-selected" : null)">
                            <button type="button" data-equipment-id="@row.Id" class="inventory-workbench__card" disabled="@(!interactiveReady)" @onclick="() => OpenAsync(row.Id)" aria-label="Ver expediente de @row.Code, @row.Name">
                                @if (PhotoAvailable(row.PhotoUrl)) { <img class="inventory-workbench__thumbnail" src="@row.PhotoUrl" alt="" @onerror="() => MarkPhotoUnavailable(row.PhotoUrl)" /> }
                                else { <span class="inventory-workbench__thumbnail inventory-workbench__thumbnail--@categoryKey" aria-hidden="true"><AppIcon Name="@CategoryIcon(categoryKey)" /></span> }
                                <span class="inventory-workbench__card-copy"><span class="inventory-workbench__card-top"><strong title="@row.Code">@row.Code</strong><span title="@row.Category">@row.Category</span></span><b title="@row.Name">@row.Name</b><small title="@ModelLine(row)">@ModelLine(row)</small><span class="inventory-workbench__card-responsible"><small>Responsable</small> No disponible</span>@PrimaryConditionBadge(row.PhysicalCondition, row.OperationalCondition)</span>
                                <span class="inventory-workbench__card-action"><AppIcon Name="arrow" /></span>
                            </button>
                        </li>
                    }
                </ul>
                @if (total > InventoryService.PageSize)
                {
                    <nav class="inventory-workbench__pagination" aria-label="Páginas de equipos"><button type="button" class="btn btn-secondary" disabled="@(currentPage == 0)" @onclick="() => LoadPageAsync(currentPage - 1)">Anterior</button><span>Página @(currentPage + 1) de @((total + InventoryService.PageSize - 1) / InventoryService.PageSize)</span><button type="button" class="btn btn-secondary" disabled="@((currentPage + 1) * InventoryService.PageSize >= total)" @onclick="() => LoadPageAsync(currentPage + 1)">Siguiente</button></nav>
                }
            }
        </div>

        <dialog class="inventory-workbench__detail" aria-labelledby="equipment-detail-title" @ref="detailPanel">
            @if (details is not null)
            {
                var detailPhotoUrl = details.PhotoUrl;
                <header class="inventory-workbench__detail-header"><h2>Detalle del equipo</h2><button type="button" class="inventory-workbench__detail-close" aria-label="Cerrar detalle" @onclick="BackToList"><AppIcon Name="close" /></button></header>
                <div class="inventory-workbench__detail-body">
                    <div class="inventory-workbench__detail-overview">
                        @if (PhotoAvailable(details.PhotoUrl))
                        {
                            <button type="button" class="inventory-workbench__photo-open" aria-label="Ver imagen completa de @details.Input.Name" @onclick="OpenPrincipalPhotoAsync">
                                <img class="inventory-workbench__detail-photo" src="@detailPhotoUrl" alt="Fotografía principal de @details.Input.Name" @onload="() => loadedPrincipalPhotos.Add(detailPhotoUrl!)" @onerror="() => MarkPhotoUnavailable(detailPhotoUrl)" />
                                <span><AppIcon Name="search" /> @(loadedPrincipalPhotos.Contains(detailPhotoUrl!) ? "Ver imagen completa" : "Cargando fotografía…")</span>
                            </button>
                        }
                        else
                        {
                            <div class="inventory-workbench__detail-photo inventory-workbench__detail-photo--empty">
                                <AppIcon Name="@CategoryIcon(selectedCategory)" />
                                <span>@(string.IsNullOrWhiteSpace(details.PhotoUrl) ? "Sin fotografía registrada" : "Fotografía no disponible")</span>
                                @if (!string.IsNullOrWhiteSpace(details.PhotoUrl)) { <button type="button" class="btn btn-secondary" @onclick="RetryPrincipalPhoto">Reintentar foto</button> }
                            </div>
                        }
                        <div class="inventory-workbench__detail-identity">
                            <h3 id="equipment-detail-title">@details.Input.Name</h3>
                            <p class="inventory-workbench__detail-code"><span>Código</span><strong>@details.Input.Code</strong></p>
                            <p class="inventory-workbench__detail-category">@CategoryLabel</p>
                            <div class="inventory-workbench__condition-summary"><div><span>Condición física</span>@ConditionBadge(null, details.Input.PhysicalCondition)</div><div><span>Condición operativa</span>@ConditionBadge(null, details.Input.OperationalCondition)</div></div>
                        </div>
                    </div>
                    <nav class="inventory-workbench__detail-tabs" aria-label="Secciones del expediente">@for (var i = 0; i < detailLabels.Length; i++) { var index = i; <button type="button" class="@(detailTab == index ? "is-active" : "")" aria-pressed="@(detailTab == index ? "true" : "false")" @onclick="() => detailTab = index">@DetailShortLabel(index)</button> }</nav>
                    <div class="inventory-workbench__detail-content">
                    @if (detailTab == 0)
                    {
                        <h3>Identificación</h3>
                        <dl class="inventory-workbench__summary-facts"><div><dt>Marca</dt><dd>@(details.Input.Brand ?? "No registrada")</dd></div><div><dt>Modelo</dt><dd>@(details.Input.Model ?? "No registrado")</dd></div><div><dt>Número de serie</dt><dd>@(details.Input.Serial ?? "No registrado")</dd></div></dl>
                        <h3>Ubicación y responsable</h3>
                        <dl class="inventory-workbench__summary-facts"><div><dt>Sede</dt><dd>@(details.Input.Site ?? "No registrada")</dd></div><div><dt>Ubicación actual</dt><dd>@(details.Input.Location ?? "No registrada")</dd></div><div><dt>Responsable</dt><dd>No disponible</dd></div></dl>
                        <p class="inventory-workbench__honest-note">Responsables y asignaciones aún no están habilitados.</p>
                    }
                    else if (detailTab == 1) { <h3>Características técnicas</h3><dl class="inventory-workbench__facts"><div><dt>Procesador</dt><dd>@(details.Input.ProcessorName ?? details.Input.ProcessorModel ?? "No registrado")</dd></div><div><dt>RAM total</dt><dd>@FormatCapacity(details.Input.TotalRamGb)</dd></div><div><dt>Módulos de RAM</dt><dd>@(details.Input.RamModules.Count == 0 ? "Sin detalle" : string.Join(" + ", details.Input.RamModules.Select(x => FormatCapacity(x.CapacityGb))))</dd></div><div><dt>Sistema operativo</dt><dd>@(details.Input.OperatingSystem ?? "No registrado")</dd></div></dl> }
                    else if (detailTab == 2) { <h3>Condición y ubicación</h3><dl class="inventory-workbench__facts"><div><dt>Sede</dt><dd>@(details.Input.Site ?? "No registrada")</dd></div><div><dt>Ubicación física</dt><dd>@(details.Input.Location ?? "No registrada")</dd></div><div><dt>Última persona que verificó</dt><dd>@(details.Input.Verifier ?? "Sin verificación")</dd></div></dl> }
                    else if (detailTab == 3) { <h3>Historial técnico</h3>@if (details.History.Count == 0) { <p>No hay revisiones ni observaciones registradas.</p> } else { <ul class="inventory-workbench__history">@foreach (var entry in details.History) { <li>@entry</li> }</ul> } }
                    else { <EquipmentPhotos @key="details.Id" EquipmentId="details.Id" Changed="PhotosChangedAsync" /> }
                    </div>
                </div>
                <footer class="inventory-workbench__detail-footer"><button type="button" class="btn btn-secondary" @onclick="BackToList">Cerrar</button><button type="button" class="btn btn-primary" title="@WriteRestriction" @onclick="OpenEditAsync" disabled="@(!interactiveReady || !canWrite)"><AppIcon Name="folder" /> Editar expediente</button></footer>
                <EquipmentPhotoViewer @ref="principalViewer" />
            }
        </dialog>
    </div>

    <dialog @ref="formDialog" class="technical-preview @(quick ? "technical-preview--quick" : "")" aria-labelledby="technical-preview-title" aria-describedby="form-summary">
    <form @onsubmit="SubmitAsync" @onsubmit:preventDefault @oninput="MarkDirty" @onchange="MarkDirty">
    <div class="technical-preview__top">
    <header class="technical-preview__header">
        <div>
            <h2 id="technical-preview-title">@(editingId is null ? quick ? "Registro rápido" : "Nuevo equipo" : editingIsDraft ? "Retomar borrador" : "Editar equipo")</h2>
            <p id="form-summary">@(editingIsDraft ? "Para finalizar: código, categoría, nombre y una fotografía principal confirmada. Puede guardar un borrador incompleto." : "Registro definitivo. Las revisiones y fotografías anteriores se conservan.")</p>
            @if (!canWrite) { <p role="status">Solo lectura: su perfil o la rama de pruebas no permiten guardar.</p> }
        </div>
        <button type="button" class="technical-preview__close" aria-label="Cerrar formulario" disabled="@(saving || photoBusy)" @onclick="RequestCloseAsync">Cerrar</button>
    </header>
    @if (!quick)
    {
        <div class="technical-preview__tabs" role="tablist" aria-label="Secciones del formulario" @onkeydown="HandleTabKeyDown">
            @for (var i = 0; i < tabLabels.Length; i++)
            {
                var index = i;
                <button type="button" id="form-tab-@index" role="tab" aria-selected="@(activeTab == index ? "true" : "false")"
                        aria-controls="form-panel" tabindex="@(activeTab == index ? 0 : -1)"
                        class="@(activeTab == index ? "is-active" : "")" @onclick="() => SetTab(index)">@(index + 1). @tabLabels[index]</button>
            }
        </div>
        <div class="technical-preview__mobile-progress" aria-live="polite"><span>Paso @(activeTab + 1) de 3</span><strong>@tabLabels[activeTab]</strong><span class="technical-preview__progress-track"><span style="width:@((activeTab + 1) * 100 / 3)%"></span></span></div>
    }
    </div>

    <div class="technical-preview__body technical-preview__body--form" role="tabpanel" id="form-panel" aria-labelledby="@(quick ? "technical-preview-title" : $"form-tab-{activeTab}")">
        @if (error is not null) { <p class="technical-preview__feedback technical-preview__feedback--error" role="alert" tabindex="-1">@error</p> }
        @if (success is not null) { <p class="technical-preview__feedback" role="status">@success</p> }
        @if (activeTab == 0)
        {
        <fieldset class="technical-preview__section technical-preview__section--first">
            <legend>Identidad del activo</legend>
            <div class="technical-preview__grid">
                <div class="field">
                    <label for="asset-code">Código único <span class="technical-preview__required">obligatorio</span></label>
                    <input id="asset-code" type="text" autocomplete="off" maxlength="80" required @bind="assetCode" @bind:event="oninput" aria-describedby="asset-code-help" />
                    <small id="asset-code-help">Conserva el código original del equipo.</small>
                </div>
                <div class="field technical-preview__category">
                    <label for="technical-category">Categoría <span class="technical-preview__required">obligatoria</span></label>
                    <select id="technical-category" required disabled="@(editingId is not null && !editingIsDraft)" @bind="selectedCategory" aria-describedby="@(editingId is not null ? "technical-category-help" : null)">
                        <option value="">Seleccione una categoría</option>
                        <option value="desktop">Computadora de escritorio</option>
                        <option value="laptop">Laptop</option>
                        <option value="monitor">Monitor</option>
                        <option value="camera">Cámara</option>
                        <option value="external-disk">Disco externo</option>
                        <option value="peripheral">Periférico</option>
                        <option value="recording">Equipo de grabación</option>
                        <option value="other">Otro dispositivo</option>
                    </select>
                    @if (editingId is not null) { <small id="technical-category-help">@(editingIsDraft ? "Puede cambiar la categoría mientras sea borrador." : "La categoría se conserva después del alta.")</small> }
                </div>
                <div class="field">
                    <label for="asset-name">Nombre descriptivo <span class="technical-preview__required">obligatorio</span></label>
                    <input id="asset-name" type="text" autocomplete="off" maxlength="200" required @bind="assetName" @bind:event="oninput" />
                </div>
            </div>
        </fieldset>
        }

        @if (selectedCategory != "" && !quick)
        {
            <div class="technical-preview__content">
                @if (activeTab == 0)
                {
                <fieldset class="technical-preview__section">
                    <legend>Datos de identificación complementarios</legend>
                    <div class="technical-preview__grid">
                        <div class="field">
                            <label for="technical-brand">Marca</label>
                            <input id="technical-brand" type="text" autocomplete="off" @bind="common.Brand" />
                        </div>
                        <div class="field">
                            <label for="technical-model">Modelo</label>
                            <input id="technical-model" type="text" autocomplete="off" @bind="common.Model" />
                        </div>
                        <div class="field">
                            <label for="technical-serial">Número de serie</label>
                            <input id="technical-serial" type="text" autocomplete="off" @bind="common.Serial" @bind:event="oninput" disabled="@(common.SerialState == "not-applicable")" />
                        </div>
                    </div>
                    <details class="registration-options">
                        <summary>Opciones del número de serie <span>@StateCaption(common.SerialState)</span></summary>
                        <label for="serial-status">Disponibilidad de la serie</label>
                        <select id="serial-status" @bind="common.SerialState" @bind:after="OnSerialStatusChanged">
                            <option value="unrecorded">@(string.IsNullOrWhiteSpace(common.Serial) ? "No registrado" : "Dato informado")</option>
                            <option value="pending">Pendiente de verificar</option><option value="not-applicable">No aplica</option>
                        </select>
                    </details>
                </fieldset>
                }

                @if (activeTab == 2)
                {
                <fieldset class="technical-preview__section">
                    <legend>Ubicación y condición</legend>
                    <div class="technical-preview__grid">
                        <div class="field">
                            <label for="asset-location">Ubicación física</label>
                            <input id="asset-location" type="text" maxlength="160" @bind="common.Location" @bind:event="oninput" disabled="@(common.LocationState == "not-applicable")" />
                        </div>
                        <div class="field">
                            <label for="asset-city">Sede</label>
                            <input id="asset-city" type="text" maxlength="120" @bind="common.City" />
                        </div>
                        <div class="field">
                            <label for="physical-state">Condición física</label>
                            <input id="physical-state" type="text" maxlength="100" placeholder="Describa lo observado" @bind="common.PhysicalCondition" disabled="@(common.PhysicalState == "not-applicable")" />
                        </div>
                        <div class="field">
                            <label for="operational-state">Condición operativa</label>
                            <input id="operational-state" type="text" maxlength="100" placeholder="Describa lo observado" @bind="common.OperationalCondition" disabled="@(common.OperationalState == "not-applicable")" />
                        </div>
                    </div>
                    @if (string.IsNullOrWhiteSpace(common.City) != string.IsNullOrWhiteSpace(common.Location))
                    { <p class="registration-help">En esta versión, sede y ubicación se guardan juntas.</p> }
                    @if (ConditionsChanged)
                    {
                        <div class="field registration-inspector"><label for="condition-inspector">Persona que inspeccionó estas condiciones</label>
                            <input id="condition-inspector" type="text" maxlength="200" @bind="common.Inspector" />
                        </div>
                    }
                    <details class="registration-options">
                        <summary>Estados especiales de control <span>@ControlStateCaption</span></summary>
                        <div class="technical-preview__grid">
                            <div class="field"><label for="location-status">Ubicación</label><select id="location-status" @bind="common.LocationState" @bind:after="OnLocationStatusChanged"><option value="unrecorded">@(CleanForm(common.Location) is null ? "No registrado" : "Dato informado")</option><option value="pending">Pendiente de verificar</option><option value="not-applicable">No aplica</option></select></div>
                            <div class="field"><label for="physical-status">Condición física</label><select id="physical-status" @bind="common.PhysicalState" @bind:after="OnPhysicalStatusChanged"><option value="unrecorded">@(CleanForm(common.PhysicalCondition) is null ? "No registrado" : "Dato informado")</option><option value="pending">Pendiente de verificar</option><option value="not-applicable">No aplica</option></select></div>
                            <div class="field"><label for="operational-status">Condición operativa</label><select id="operational-status" @bind="common.OperationalState" @bind:after="OnOperationalStatusChanged"><option value="unrecorded">@(CleanForm(common.OperationalCondition) is null ? "No registrado" : "Dato informado")</option><option value="pending">Pendiente de verificar</option><option value="not-applicable">No aplica</option></select></div>
                            <div class="field"><label for="verification-status">Verificación</label><select id="verification-status" @bind="common.VerificationState"><option value="unrecorded">Sin nueva marca</option><option value="pending">Pendiente de verificar</option><option value="not-applicable">No aplica</option></select></div>
                        </div>
                        <p>Sin marca especial: los campos vacíos permanecen no registrados.</p>
                    </details>
                </fieldset>
                }

                @if (activeTab == 1 && selectedCategory is "desktop" or "laptop")
                {
                    <fieldset class="technical-preview__section" @oninput="MarkTechnicalDirty" @onchange="MarkTechnicalDirty">
                        <legend>Procesador y memoria</legend>
                        <div class="technical-preview__grid">
                            <div class="field">
                                <label for="processor-name">Procesador</label>
                                <input id="processor-name" type="text" @bind="Current.ProcessorName" />
                            </div>
                            <div class="field">
                                <label for="ram-total">RAM total (GB) @(Current.CalculatesRam ? "· calculada" : "")</label>
                                <input id="ram-total" type="number" min="0.01" step="any" inputmode="decimal" @bind="RamTotalEditor" @bind:event="oninput" readonly="@Current.CalculatesRam" disabled="@(Current.RamState == "not-applicable")" />
                            </div>
                        </div>
                        <div class="technical-preview__list-head">
                            <div>
                                <h3>Módulos de RAM</h3>
                            </div>
                            <button type="button" class="btn btn-secondary" @onclick="AddRamModule">Añadir módulo</button>
                        </div>
                        @foreach (var module in Current.RamModules)
                        {
                            <div class="technical-preview__item" @key="module.Id">
                                <div class="field">
                                    <label for="ram-@module.Id">Capacidad <span class="technical-preview__optional">GB</span></label>
                                    <input id="ram-@module.Id" type="number" min="0.01" step="any" inputmode="decimal" @bind="module.Capacity" @bind:event="oninput" />
                                </div>
                                <button type="button" class="btn btn-secondary" aria-label="Quitar módulo de RAM" @onclick="() => RemoveRamModule(module)">Quitar</button>
                            </div>
                        }
                        @if (Current.RamModules.Count > 0)
                        {
                            <label class="registration-check"><input id="ram-modules-complete" type="checkbox" @bind="Current.RamModulesComplete" /> He registrado todos los módulos</label>
                            @if (!Current.RamModulesComplete) { <p class="registration-help">Detalle parcial: conserva la RAM total conocida o déjala vacía.</p> }
                        }
                        <details class="registration-options">
                            <summary>Detalles avanzados del procesador <span>@(HasAdvancedProcessor ? "Con datos" : "Opcional")</span></summary>
                            <div class="technical-preview__grid">
                                <div class="field"><label for="processor-maker">Fabricante del procesador</label><input id="processor-maker" type="text" maxlength="120" @bind="Current.ProcessorManufacturer" /></div>
                                <div class="field"><label for="processor-model">Modelo del procesador</label><input id="processor-model" type="text" maxlength="160" @bind="Current.ProcessorModel" /></div>
                            </div>
                        </details>
                    </fieldset>

                    <fieldset class="technical-preview__section" @oninput="MarkTechnicalDirty" @onchange="MarkTechnicalDirty">
                        <legend>Almacenamiento y software</legend>
                        <div class="technical-preview__list-head">
                            <div>
                                <h3>Discos conocidos</h3>
                            </div>
                            <button type="button" class="btn btn-secondary" @onclick="AddStorageUnit">Añadir disco</button>
                        </div>
                        @foreach (var unit in Current.StorageUnits)
                        {
                            <div class="technical-preview__item technical-preview__item--storage" @key="unit.Id">
                                <div class="field">
                                    <label for="drive-type-@unit.Id">Tipo</label>
                                    <select id="drive-type-@unit.Id" @bind="unit.Type">
                                        <option value="">Seleccione tipo</option>
                                        <option value="SSD">SSD</option>
                                        <option value="HDD">HDD</option>
                                        @if (unit.Type is not ("" or "SSD" or "HDD")) { <option value="@unit.Type">@unit.Type (registrado)</option> }
                                    </select>
                                </div>
                                <div class="field">
                                    <label for="drive-interface-@unit.Id">Interfaz</label>
                                    <select id="drive-interface-@unit.Id" @bind="unit.Interface">
                                        <option value="">No registrada</option>
                                        <option value="NVMe">NVMe</option>
                                        <option value="SATA">SATA</option>
                                        <option value="USB">USB</option>
                                        <option value="other">Otra</option>
                                        @if (unit.Interface is not ("" or "NVMe" or "SATA" or "USB" or "other")) { <option value="@unit.Interface">@unit.Interface (registrada)</option> }
                                    </select>
                                </div>
                                <div class="field">
                                    <label for="drive-capacity-@unit.Id">Capacidad</label>
                                    <input id="drive-capacity-@unit.Id" type="number" min="0.01" step="any" inputmode="decimal" @bind="unit.Capacity" />
                                </div>
                                <div class="field">
                                    <label for="drive-unit-@unit.Id">Unidad</label>
                                    <select id="drive-unit-@unit.Id" @bind="unit.Unit">
                                        <option value="GB">GB</option>
                                        <option value="TB">TB</option>
                                    </select>
                                </div>
                                <button type="button" class="btn btn-secondary" aria-label="Quitar unidad de almacenamiento" @onclick="() => RemoveStorageUnit(unit)">Quitar</button>
                            </div>
                        }
                        <div class="field technical-preview__wide">
                            <label for="technical-os">Sistema operativo</label>
                            <input id="technical-os" type="text" @bind="Current.OperatingSystem" @bind:event="oninput" disabled="@(Current.OsState == "not-applicable")" />
                        </div>
                        <details class="registration-options">
                            <summary>Estados especiales de datos técnicos <span>@TechnicalStateCaption</span></summary>
                            <div class="technical-preview__grid">
                                <div class="field"><label for="ram-status">RAM</label><select id="ram-status" @bind="Current.RamState" @bind:after="OnRamStatusChanged"><option value="unrecorded">@(Current.EffectiveRam is null && Current.RamModules.Count == 0 ? "No registrado" : "Dato informado")</option><option value="pending">Pendiente de verificar</option><option value="not-applicable">No aplica</option></select></div>
                                <div class="field"><label for="storage-status">Discos</label><select id="storage-status" @bind="Current.StorageState" @bind:after="OnStorageStatusChanged"><option value="unrecorded">@(Current.StorageUnits.Count == 0 ? "No registrado" : "Dato informado")</option><option value="pending">Pendiente de verificar</option><option value="not-applicable">No aplica</option></select></div>
                                <div class="field"><label for="os-status">Sistema operativo</label><select id="os-status" @bind="Current.OsState" @bind:after="OnOsStatusChanged"><option value="unrecorded">@(CleanForm(Current.OperatingSystem) is null ? "No registrado" : "Dato informado")</option><option value="pending">Pendiente de verificar</option><option value="not-applicable">No aplica</option></select></div>
                            </div>
                            <p>Sin marca especial: los campos vacíos permanecen no registrados.</p>
                        </details>
                    </fieldset>
                }
                else if (activeTab == 1)
                {
                    <p class="registration-help">Esta categoría no tiene campos técnicos adicionales habilitados. Puedes continuar con control y fotografías.</p>
                }

                @if (activeTab == 2)
                {
                <fieldset class="technical-preview__section">
                    <legend>Observaciones y verificación</legend>
                    <div class="field technical-preview__wide">
                        <label for="technical-notes">Observaciones nuevas</label>
                        <textarea id="technical-notes" rows="3" @bind="Current.Notes"></textarea>
                    </div>
                    <label class="registration-check"><input id="last-verified-on" type="checkbox" @bind="common.VerifyNow" @bind:after="OnVerificationChanged" /> Registrar verificación técnica ahora</label>
                    @if (common.VerifyNow)
                    {
                        <div class="field registration-verifier"><label for="last-verified-by">Persona que realizó la verificación</label>
                            <input id="last-verified-by" type="text" maxlength="200" @bind="common.VerifiedBy" @bind:event="oninput" />
                            <small>Se registra la hora actual del servidor. Indica a quien realmente verificó el equipo.</small>
                        </div>
                    }
                </fieldset>
                    @if (PendingChecks.Count > 0)
                    {
                        <p class="registration-pending" role="status"><strong>Por verificar:</strong> @string.Join(" · ", PendingChecks)</p>
                    }
                }
            </div>
        }
        else if (activeTab != 0 && !quick)
        {
            <p class="technical-preview__hint">Seleccione una categoría en Identificación para completar esta sección.</p>
        }
        @if ((quick || activeTab == 2) && !photosOpen)
        {
            <section class="registration-photos-start" aria-label="Continuar con fotografías">
                <h3>@(editingIsDraft ? "Fotografía principal obligatoria" : "Fotografías del equipo")</h3>
                <p>@(editingIsDraft ? "Suba una o varias fotos. La primera confirmada se usará como principal; puede cambiarla después." : "Añada imágenes sin eliminar las evidencias anteriores.")</p>
                <button type="button" class="btn btn-secondary" disabled="@(saving || !canWrite)" @onclick="() => SaveAsync(false, true)">@(editingIsDraft ? "Guardar borrador y añadir fotografías" : "Guardar cambios y abrir fotografías")</button>
            </section>
        }
        @if (photosOpen && editingId is Guid savedId)
        {
            <section class="registration-photos" hidden="@(!quick && activeTab != 2)" aria-label="Fotografías del equipo guardado" @oninput:stopPropagation="true" @onchange:stopPropagation="true">
                <p class="registration-saved" role="status">@(editingIsDraft ? "Borrador guardado. Las fotografías y los reintentos usan este mismo expediente." : "Las fotografías se vinculan a este mismo expediente.")</p>
                <EquipmentPhotos @key="savedId" EquipmentId="savedId" Changed="FormPhotosChangedAsync" QueueChanged="PhotoQueueChangedAsync" />
            </section>
        }
        @if (editingIsDraft)
        {
            <p class="registration-readiness" role="status">@(dirty && editingId is not null ? "Hay cambios sin guardar. Guarde el borrador antes de finalizar." : readiness?.Message ?? "Borrador: falta guardar y confirmar una fotografía principal para finalizar.")</p>
        }
    </div>
    <div class="technical-preview__actions">
        <div class="technical-preview__step-actions">
            @if (!quick && activeTab > 0) { <button class="btn btn-secondary" type="button" @onclick="() => SetTab(activeTab - 1)">Anterior</button> }
            @if (!quick && activeTab < 2) { <button class="btn btn-secondary" type="button" @onclick="NextStep">Siguiente</button> }
        </div>
        <div class="technical-preview__save-actions">
            <button type="button" class="btn btn-secondary" disabled="@(saving || photoBusy)" @onclick="RequestCloseAsync">@(photosOpen ? "Cerrar" : "Cancelar")</button>
            @if (editingIsDraft)
            {
                <button type="button" class="btn btn-secondary" @onclick="() => SaveAsync(false)" disabled="@(saving || photoBusy || !canWrite)">Guardar borrador</button>
                <button type="submit" class="btn btn-primary" disabled="@(saving || photoBusy || !canWrite || dirty || photoPending > 0 || readiness?.CanFinalize != true)">@(saving ? "Confirmando…" : "Finalizar registro")</button>
            }
            else
            {
                <button type="submit" class="btn btn-primary" disabled="@(saving || photoBusy || !canWrite)">@(saving ? "Guardando…" : "Guardar y cerrar")</button>
            }
        </div>
    </div>
    </form>
</dialog>
</section>

@code {
    private static readonly string[] tabLabels = ["Identificación", "Características técnicas", "Control y fotografías"];
    private static readonly string[] detailLabels = ["Información general", "Características técnicas", "Condición y ubicación", "Historial técnico", "Fotografías"];
    private ElementReference formDialog;
    private ElementReference listPanel;
    private ElementReference detailPanel;
    private EquipmentPhotoViewer? principalViewer;
    private readonly HashSet<string> loadedPrincipalPhotos = [];
    private bool canWrite;
    private bool interactiveReady;
    private IJSObjectReference? uiModule;
    private DotNetObjectReference<TechnicalFormPreview>? dotNetRef;
    private bool openRequested;
    private bool focusErrorRequested;
    private bool focusCodeRequested;
    private int? focusTabRequested;
    private bool detailOpenRequested;
    private bool detailCloseRequested;
    private bool quick;
    private bool dirty;
    private int activeTab;
    private int detailTab;
    private string search = "";
    private string categoryFilter = "";
    private string conditionFilter = "";
    private int currentPage;
    private int total;
    private IReadOnlyList<ConditionOption> conditionOptions = [];
    private CancellationTokenSource? searchDelay;
    private IReadOnlyList<EquipmentRow> rows = [];
    private EquipmentDetails? details;
    private Guid? editingId;
    private bool editingIsDraft = true, showDrafts;
    private string CountLabel(int count) => showDrafts ? count == 1 ? "borrador" : "borradores" : count == 1 ? "equipo" : "equipos";
    private Guid draftKey = Guid.NewGuid();
    private int draftRevision;
    private RegistrationReadiness? readiness;
    private bool loading = true;
    private bool saving;
    private string? error;
    private string? success;
    private readonly HashSet<string> failedPhotos = [];
    private bool photosOpen, photoBusy;
    private int photoPending;
    private string? originalPhysical, originalOperational;
    private readonly HashSet<string> originalPending = [];
    private readonly HashSet<string> originalNotApplicable = [];
    private bool HasAdvancedProcessor => !string.IsNullOrWhiteSpace(Current.ProcessorManufacturer) || !string.IsNullOrWhiteSpace(Current.ProcessorModel);
    private bool ConditionsChanged => (CleanForm(common.PhysicalCondition) is not null || CleanForm(common.OperationalCondition) is not null) &&
        (editingIsDraft || CleanForm(common.PhysicalCondition) != originalPhysical || CleanForm(common.OperationalCondition) != originalOperational);
    private static string? CleanForm(string? value) => string.IsNullOrWhiteSpace(value) ? null : value.Trim();
    private static string StateCaption(string state) => state switch { "pending" => "Pendiente", "not-applicable" => "No aplica", _ => "Opcional" };
    private string ControlStateCaption => SpecialCaption(common.LocationState, common.PhysicalState, common.OperationalState, common.VerificationState);
    private string TechnicalStateCaption => SpecialCaption(Current.RamState, Current.StorageState, Current.OsState);
    private static string SpecialCaption(params string[] states) => states.Count(x => x != "unrecorded") is var count && count > 0 ? $"{count} marcados" : "Opcional";
    private decimal? RamTotalEditor { get => Current.EffectiveRam; set { Current.TotalRamGb = value; MarkTechnicalDirty(); } }

    protected override async Task OnInitializedAsync()
    {
        canWrite = await Inventory.CanWriteAsync();
        await RefreshAsync();
        try { conditionOptions = await Inventory.GetConditionOptionsAsync(); }
        catch { /* The list still works with its general filters if options are temporarily unavailable. */ }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            interactiveReady = true;
            uiModule = await JS.InvokeAsync<IJSObjectReference>("import", "./Components/Inventory/TechnicalFormPreview.razor.js");
            await uiModule.InvokeVoidAsync("bindInventoryKeys", listPanel);
            await InvokeAsync(StateHasChanged);
        }
        if (detailCloseRequested && uiModule is not null)
        {
            await uiModule.InvokeVoidAsync("closeDetail", detailPanel, listPanel);
            detailCloseRequested = false;
        }
        if (openRequested)
        {
            uiModule ??= await JS.InvokeAsync<IJSObjectReference>("import", "./Components/Inventory/TechnicalFormPreview.razor.js");
            dotNetRef ??= DotNetObjectReference.Create(this);
            await uiModule.InvokeVoidAsync("openForm", formDialog, dotNetRef);
            openRequested = false;
        }
        if (focusErrorRequested && uiModule is not null)
        {
            focusErrorRequested = false;
            await uiModule.InvokeVoidAsync("focusError", formDialog);
        }
        if (focusCodeRequested && uiModule is not null)
        {
            focusCodeRequested = false;
            await uiModule.InvokeVoidAsync("focusCode", formDialog);
        }
        if (focusTabRequested is { } tab && uiModule is not null)
        {
            focusTabRequested = null;
            await uiModule.InvokeVoidAsync("focusTab", tab);
        }
        if (detailOpenRequested)
        {
            uiModule ??= await JS.InvokeAsync<IJSObjectReference>("import", "./Components/Inventory/TechnicalFormPreview.razor.js");
            dotNetRef ??= DotNetObjectReference.Create(this);
            await uiModule.InvokeVoidAsync("openDetail", detailPanel, listPanel, dotNetRef);
            detailOpenRequested = false;
        }
    }

    private async Task RefreshAsync()
    {
        loading = true;
        try
        {
            var result = await Inventory.ListAsync(search, categoryFilter, conditionFilter, currentPage, draftsOnly: showDrafts);
            rows = result.Rows;
            total = result.Total;
            error = null;
        }
        catch { error = "No se pudo consultar el inventario. Compruebe la conexión de la rama de pruebas."; }
        finally { loading = false; }
    }

    private async Task DebouncedRefreshAsync()
    {
        searchDelay?.Cancel();
        searchDelay?.Dispose();
        var delay = searchDelay = new CancellationTokenSource();
        try { await Task.Delay(250, delay.Token); currentPage = 0; await RefreshAsync(); }
        catch (OperationCanceledException) { }
    }

    private async Task ApplyFiltersAsync()
    {
        currentPage = 0;
        await RefreshAsync();
    }

    private async Task SwitchRegistrationListAsync(bool draftsOnly)
    {
        showDrafts = draftsOnly;
        search = categoryFilter = conditionFilter = "";
        currentPage = 0;
        BackToList();
        await RefreshAsync();
    }

    private async Task LoadPageAsync(int nextPage)
    {
        currentPage = nextPage;
        await RefreshAsync();
    }

    private async Task ClearFiltersAsync()
    {
        search = categoryFilter = conditionFilter = "";
        currentPage = 0;
        await RefreshAsync();
    }

    private async Task OpenNewAsync(bool fast)
    {
        New();
        detailCloseRequested = true;
        quick = fast;
        activeTab = 0;
        openRequested = true;
        await InvokeAsync(StateHasChanged);
    }

    private async Task OpenEditAsync()
    {
        if (details is null) return;
        await OpenAsync(details.Id);
        if (error is not null) return;
        detailOpenRequested = false;
        detailCloseRequested = true;
        quick = false;
        activeTab = 0;
        dirty = false;
        error = success = null;
        openRequested = true;
        await InvokeAsync(StateHasChanged);
    }

    private async Task OpenPrincipalPhotoAsync()
    {
        if (principalViewer is not null && details?.PhotoUrl is { } url && PhotoAvailable(url))
            await principalViewer.OpenAsync(url, details.Input.Name, details.Input.Code);
    }

    private void RetryPrincipalPhoto()
    {
        if (details?.PhotoUrl is { } url) { failedPhotos.Remove(url); loadedPrincipalPhotos.Remove(url); }
    }

    private async Task PhotosChangedAsync()
    {
        if (details is null) return;
        var id = details.Id;
        failedPhotos.Clear();
        await RefreshAsync();
        details = await Inventory.GetAsync(id);
    }

    private void MarkDirty() => dirty = true;
    private void MarkTechnicalDirty() { dirty = true; Current.IsDirty = true; }
    private async Task FormPhotosChangedAsync()
    {
        failedPhotos.Clear();
        await RefreshAsync();
        if (details?.Id == editingId && editingId is Guid id) details = await Inventory.GetAsync(id);
        if (editingIsDraft && editingId is Guid draft)
        {
            try { readiness = await Inventory.GetRegistrationReadinessAsync(draft); }
            catch { readiness = null; error = "No se pudo confirmar la fotografía principal. Actualice la galería para reintentar."; }
        }
    }
    private Task PhotoQueueChangedAsync(PhotoQueueState state)
    {
        photoBusy = state.Busy; photoPending = state.Pending;
        return Task.CompletedTask;
    }

    private void SetTab(int index)
    {
        activeTab = Math.Clamp(index, 0, 2);
        focusTabRequested = activeTab;
        error = null;
    }

    private void NextStep()
    {
        if (activeTab == 0 && (string.IsNullOrWhiteSpace(assetCode) || string.IsNullOrWhiteSpace(assetName) || string.IsNullOrWhiteSpace(selectedCategory)))
        {
            error = "Complete código, categoría y nombre antes de continuar.";
            focusErrorRequested = true;
            return;
        }
        SetTab(activeTab + 1);
    }

    private async Task HandleTabKeyDown(KeyboardEventArgs e)
    {
        var index = e.Key switch
        {
            "ArrowRight" => (activeTab + 1) % 3,
            "ArrowLeft" => (activeTab + 2) % 3,
            "Home" => 0,
            "End" => 2,
            _ => -1
        };
        if (index < 0) return;
        SetTab(index);
        await InvokeAsync(StateHasChanged);
    }

    [JSInvokable]
    public Task OnDialogCancelAsync() => RequestCloseAsync();

    private async Task RequestCloseAsync()
    {
        if (saving || photoBusy) return;
        if ((dirty || photoPending > 0) && uiModule is not null && !await uiModule.InvokeAsync<bool>("confirmDiscard",
            photosOpen ? "El equipo y las fotos confirmadas se conservarán. ¿Cerrar y descartar cambios o archivos todavía no guardados?" : null)) return;
        await CloseDialogAsync();
    }

    private async Task CloseDialogAsync()
    {
        if (uiModule is not null) await uiModule.InvokeVoidAsync("closeForm", formDialog);
        dirty = false;
        photosOpen = false; photoPending = 0; photoBusy = false;
        error = null;
    }

    private void BackToList()
    {
        details = null;
        editingId = null;
        draftKey = Guid.NewGuid(); draftRevision = 0; editingIsDraft = true; readiness = null;
        detailTab = 0;
        detailCloseRequested = true;
    }

    [JSInvokable]
    public async Task OnDetailCancelAsync()
    {
        BackToList();
        await InvokeAsync(StateHasChanged);
    }

    private async Task HandleRowKeyDownAsync(KeyboardEventArgs eventArgs, Guid id)
    {
        if (eventArgs.Key is "Enter" or " ") await OpenAsync(id);
    }

    private bool PhotoAvailable(string? photoUrl) => !string.IsNullOrWhiteSpace(photoUrl) && !failedPhotos.Contains(photoUrl);

    private void MarkPhotoUnavailable(string? photoUrl)
    {
        if (!string.IsNullOrWhiteSpace(photoUrl)) failedPhotos.Add(photoUrl);
    }

    private static string FormatCapacity(decimal? value, string? unit = "GB") => value is null
        ? "No registrada" : $"{value.Value.ToString("0.###", CultureInfo.GetCultureInfo("es-BO"))} {unit ?? "GB"}";

    private string WriteRestriction => interactiveReady && !canWrite
        ? "No disponible para este perfil o entorno."
        : "";

    private static string ModelLine(EquipmentRow row) => (row.Brand, row.Model) switch
    {
        ({ } brand, { } model) => $"{brand} · {model}",
        ({ } brand, null) => brand,
        (null, { } model) => model,
        _ => "Marca y modelo no registrados"
    };

    private static string CategoryKey(string category) => category switch
    {
        "Computadora de escritorio" => "desktop",
        "Laptop" => "laptop",
        "Monitor" => "monitor",
        "Cámara" => "camera",
        "Disco externo" => "external-disk",
        "Periférico" => "peripheral",
        "Equipo de grabación" => "recording",
        _ => "other"
    };

    private static string CategoryIcon(string category) => category switch
    {
        "desktop" => "desktop",
        "laptop" => "laptop",
        "monitor" => "monitor",
        "camera" => "camera",
        "external-disk" => "disk",
        "peripheral" => "peripheral",
        "recording" => "recording",
        _ => "device"
    };

    private static string DetailShortLabel(int index) => index switch
    {
        0 => "General",
        1 => "Técnica",
        2 => "Control",
        3 => "Historial",
        _ => "Fotografías"
    };

    private static RenderFragment ConditionBadge(string? label, string? condition) => builder =>
    {
        var value = string.IsNullOrWhiteSpace(condition) ? "No registrada" : condition.Trim();
        builder.OpenElement(0, "span");
        builder.AddAttribute(1, "class", $"inventory-workbench__condition inventory-workbench__condition--{ConditionTone(value)}");
        builder.AddAttribute(2, "title", value);
        if (!string.IsNullOrWhiteSpace(label))
        {
            builder.OpenElement(3, "small");
            builder.AddContent(4, label);
            builder.CloseElement();
        }
        builder.AddContent(5, value);
        builder.CloseElement();
    };

    private static RenderFragment PrimaryConditionBadge(string? physical, string? operational) =>
        ConditionBadge(null, operational ?? physical);

    private static string ConditionTone(string value)
    {
        var normalized = value.Trim().ToLowerInvariant();
        if (normalized is "malo" or "mala" or "en mal estado" or "dañado" or "dañada" or "inoperativo" or "inoperativa" or
            "no operativo" or "no operativa" or "no funciona" or "defectuoso" or "defectuosa" or "crítico" or "crítica") return "danger";
        if (normalized is "regular" or "con desgaste" or "requiere revisión" or "pendiente" or "reparable") return "warning";
        if (normalized is "bueno" or "buena" or "buen estado" or "en buen estado" or "operativo" or "operativa" or "funcional" or
            "excelente" or "nuevo" or "nueva") return "positive";
        return "neutral";
    }

    public async ValueTask DisposeAsync()
    {
        searchDelay?.Cancel();
        searchDelay?.Dispose();
        dotNetRef?.Dispose();
        if (uiModule is not null)
        {
            try { await uiModule.InvokeVoidAsync("closeForm", formDialog); } catch (JSDisconnectedException) { }
            try { await uiModule.InvokeVoidAsync("closeDetail", detailPanel, listPanel); } catch (JSDisconnectedException) { }
            try { await uiModule.InvokeVoidAsync("disposeInventoryLayout", listPanel); } catch (JSDisconnectedException) { }
            try { await uiModule.DisposeAsync(); } catch (JSDisconnectedException) { }
        }
    }

    private void New()
    {
        editingId = null;
        draftKey = Guid.NewGuid(); draftRevision = 0; editingIsDraft = true; readiness = null;
        details = null;
        selectedCategory = "";
        assetCode = assetName = null;
        common = new CommonDraft();
        drafts.Clear();
        dirty = false;
        activeTab = detailTab = 0;
        error = success = null;
        photosOpen = false; photoPending = 0; photoBusy = false;
        originalPhysical = originalOperational = null;
        originalPending.Clear(); originalNotApplicable.Clear();
    }

    private async Task OpenAsync(Guid id)
    {
        error = success = null;
        try
        {
            details = await Inventory.GetAsync(id);
            if (details is null) { error = "No se encontró el expediente."; return; }
            detailOpenRequested = true;
            editingId = id;
            editingIsDraft = details.IsDraft; draftKey = id; draftRevision = details.RegistrationRevision; readiness = null;
            detailTab = 0;
            var input = details.Input;
            selectedCategory = input.Category;
            assetCode = input.Code;
            assetName = input.Name;
            drafts.Clear();
            common = new CommonDraft
            {
                Brand = input.Brand, Model = input.Model, Serial = input.Serial,
                SerialState = input.SerialStatus, Location = input.Location, City = input.Site,
                PhysicalCondition = input.PhysicalCondition ?? "",
                OperationalCondition = input.OperationalCondition ?? "",
                LocationState = Status(input, "location"),
                PhysicalState = Status(input, "physical_condition"),
                OperationalState = Status(input, "operational_condition"),
                VerificationState = Status(input, "verification")
            };
            if (editingIsDraft) { common.Inspector = input.Inspector; common.VerifyNow = input.VerifyNow; common.VerifiedBy = input.Verifier; }
            originalPhysical = CleanForm(input.PhysicalCondition);
            originalOperational = CleanForm(input.OperationalCondition);
            originalPending.Clear(); originalPending.UnionWith(input.PendingFields);
            originalNotApplicable.Clear(); originalNotApplicable.UnionWith(input.NotApplicableFields);
            var technical = Current;
            technical.ProcessorManufacturer = input.ProcessorManufacturer;
            technical.ProcessorModel = input.ProcessorModel;
            technical.ProcessorName = input.ProcessorName;
            technical.TotalRamGb = input.TotalRamGb;
            technical.RamModulesComplete = input.RamModulesComplete ?? false;
            technical.ExpectedRevision = input.ExpectedTechnicalRevision;
            technical.OperatingSystem = input.OperatingSystem;
            if (editingIsDraft) technical.Notes = input.Observation;
            technical.RamState = Status(input, "ram");
            technical.StorageState = Status(input, "storage");
            technical.OsState = Status(input, "operating_system");
            technical.RamModules.AddRange(input.RamModules.Select(x => new RamDraft { OriginalId = x.OriginalId, Capacity = x.CapacityGb }));
            technical.StorageUnits.AddRange(input.StorageUnits.Select(x => new StorageDraft
                { OriginalId = x.OriginalId, Type = x.Technology ?? "", Interface = x.Interface ?? "", Capacity = x.Capacity,
                  Unit = x.Unit ?? "GB" }));
            if (editingIsDraft)
            {
                readiness = await Inventory.GetRegistrationReadinessAsync(id);
                quick = false; activeTab = 0; photosOpen = true; dirty = false;
                detailOpenRequested = false; detailCloseRequested = true; details = null; openRequested = true;
            }
        }
        catch { error = "No se pudo abrir el expediente. Inténtelo nuevamente."; }
    }

    private static string Status(EquipmentInput input, string field) =>
        input.PendingFields.Contains(field) ? "pending" :
        input.NotApplicableFields.Contains(field) ? "not-applicable" : "unrecorded";

    private void OnSerialStatusChanged() { if (common.SerialState == "not-applicable") common.Serial = null; }
    private void OnLocationStatusChanged()
    {
        if (common.LocationState == "not-applicable") { common.Location = null; common.City = null; }
    }
    private void OnPhysicalStatusChanged()
    {
        if (common.PhysicalState == "not-applicable") common.PhysicalCondition = "";
    }
    private void OnOperationalStatusChanged()
    {
        if (common.OperationalState == "not-applicable") common.OperationalCondition = "";
    }
    private void OnRamStatusChanged()
    {
        if (Current.RamState == "not-applicable") { Current.TotalRamGb = null; Current.RamModules.Clear(); }
        MarkTechnicalDirty();
    }
    private void OnStorageStatusChanged() { if (Current.StorageState == "not-applicable") Current.StorageUnits.Clear(); MarkTechnicalDirty(); }
    private void OnOsStatusChanged()
    {
        if (Current.OsState == "not-applicable") Current.OperatingSystem = null;
        MarkTechnicalDirty();
    }
    private void OnVerificationChanged() { if (common.VerifyNow) common.VerificationState = "unrecorded"; }

    private async Task SaveAsync(bool closeAfter, bool continueWithPhotos = false)
    {
        if (saving || photoBusy) return;
        if (!editingIsDraft && !continueWithPhotos && photoPending > 0 && uiModule is not null && !await uiModule.InvokeAsync<bool>("confirmDiscard",
            "Se guardará el equipo. ¿Continuar y descartar los archivos que todavía no se han subido? Las fotos confirmadas se conservarán.")) return;
        saving = true;
        error = success = null;
        var committed = false;
        try
        {
            var technical = selectedCategory is "desktop" or "laptop" ? Current : new TechnicalDraft();
            var pending = new HashSet<string>(originalPending);
            var notApplicable = new HashSet<string>(originalNotApplicable);
            void State(string key, string state)
            {
                pending.Remove(key); notApplicable.Remove(key);
                if (state == "pending") pending.Add(key);
                if (state == "not-applicable") notApplicable.Add(key);
            }
            State("location", common.LocationState);
            State("physical_condition", common.PhysicalState);
            State("operational_condition", common.OperationalState);
            State("verification", common.VerifyNow ? "unrecorded" : common.VerificationState);
            if (selectedCategory is "desktop" or "laptop")
            {
                State("ram", technical.RamState); State("storage", technical.StorageState); State("operating_system", technical.OsState);
            }
            var modules = technical.BuildRam(editingIsDraft);
            var input = new EquipmentInput
            {
                Code = assetCode ?? "", Name = assetName ?? "", Category = selectedCategory,
                Brand = common.Brand, Model = common.Model, Serial = common.Serial,
                SerialStatus = common.SerialState, Site = common.City, Location = common.Location,
                PhysicalCondition = common.PhysicalCondition, OperationalCondition = common.OperationalCondition,
                Inspector = common.Inspector, VerifyNow = common.VerifyNow, Verifier = common.VerifiedBy,
                ProcessorManufacturer = technical.ProcessorManufacturer, ProcessorModel = technical.ProcessorModel,
                ProcessorName = technical.ProcessorName, TotalRamGb = technical.EffectiveRam,
                RamModulesComplete = modules.Count > 0 && technical.RamModulesComplete,
                UpdateTechnicalData = editingId is null || ((selectedCategory is "desktop" or "laptop") && technical.IsDirty),
                ExpectedTechnicalRevision = technical.ExpectedRevision,
                OperatingSystem = technical.OperatingSystem,
                RamModules = modules,
                StorageUnits = technical.BuildStorage(),
                Observation = selectedCategory == "" ? null : Current.Notes,
                PendingFields = pending.ToList(), NotApplicableFields = notApplicable.ToList()
            };
            var wasEditing = editingId is not null;
            var savedId = editingIsDraft ? await Inventory.SaveDraftAsync(input, draftKey, draftRevision) : await Inventory.SaveAsync(input, editingId);
            editingId = savedId; // Capture before any refresh: retry must update this same equipment.
            committed = true; dirty = false;
            if (!editingIsDraft) { common.VerifyNow = false; common.VerifiedBy = null; Current.Notes = null; Current.IsDirty = false; }
            else { readiness = await Inventory.GetRegistrationReadinessAsync(savedId); draftRevision = readiness.Revision; }
            originalPhysical = CleanForm(common.PhysicalCondition); originalOperational = CleanForm(common.OperationalCondition);
            originalPending.Clear(); originalPending.UnionWith(input.PendingFields);
            originalNotApplicable.Clear(); originalNotApplicable.UnionWith(input.NotApplicableFields);
            if (continueWithPhotos) { photosOpen = true; if (!quick) activeTab = 2; }
            try
            {
                var saved = await Inventory.GetAsync(savedId);
                if (saved is not null)
                {
                    if (selectedCategory is "desktop" or "laptop") HydrateTechnical(Current, saved.Input);
                    if (details?.Id == savedId) details = saved;
                }
            }
            catch { /* Keep the committed ID even if the subsequent read is unavailable. */ }
            try { conditionOptions = await Inventory.GetConditionOptionsAsync(); }
            catch { /* The saved equipment remains committed; the next visit refreshes filter options. */ }
            search = input.Code.Trim();
            categoryFilter = conditionFilter = "";
            currentPage = 0;
            await RefreshAsync();
            if (editingIsDraft)
            {
                success = "Borrador guardado. Puede retomarlo desde Borradores; todavía no cuenta como equipo definitivo.";
            }
            else if (continueWithPhotos)
            {
                success = "Equipo guardado. Puedes añadir sus fotografías sin crear otro registro.";
            }
            else if (closeAfter)
            {
                await CloseDialogAsync();
                BackToList();
                success = wasEditing ? "Cambios guardados; las revisiones anteriores se conservan." : "Equipo registrado y disponible en el listado.";
            }
            else
            {
                var wasQuick = quick;
                New();
                quick = wasQuick;
                success = "Equipo guardado. Puede registrar otro.";
                focusCodeRequested = true;
            }
        }
        catch (InventoryValidationException ex)
        {
            error = ex.Message;
            if (error.Contains("código", StringComparison.OrdinalIgnoreCase) ||
                error.Contains("categoría", StringComparison.OrdinalIgnoreCase) ||
                error.Contains("nombre", StringComparison.OrdinalIgnoreCase)) activeTab = 0;
            else if (new[] { "RAM", "módulo", "disco", "almacenamiento", "procesador", "ficha técnica", "sistema operativo" }.Any(x => error.Contains(x, StringComparison.OrdinalIgnoreCase))) activeTab = 1;
            else if (new[] { "ubicación", "sede", "condición", "inspeccion", "verificación", "persona" }.Any(x => error.Contains(x, StringComparison.OrdinalIgnoreCase))) activeTab = 2;
            focusErrorRequested = true;
        }
        catch
        {
            error = committed ? "El equipo se guardó, pero no se completó la actualización de la vista. Su ID se conserva; vuelva a intentarlo sin crear otra alta."
                : "No se pudieron guardar los cambios. Revise la conexión y vuelva a intentarlo.";
            focusErrorRequested = true;
        }
        finally { saving = false; }
    }

    private Task SubmitAsync() => editingIsDraft ? FinalizeAsync() : SaveAsync(true);

    private async Task FinalizeAsync()
    {
        if (saving || photoBusy || dirty || photoPending > 0 || editingId is not Guid id || readiness?.CanFinalize != true) return;
        saving = true; error = success = null;
        try
        {
            await Inventory.FinalizeRegistrationAsync(id, draftRevision);
            editingIsDraft = false;
            await CloseDialogAsync();
            showDrafts = false; search = assetCode ?? ""; currentPage = 0;
            await RefreshAsync();
            success = "Registro definitivo completado con fotografía principal confirmada.";
        }
        catch (InventoryValidationException ex) { error = ex.Message; focusErrorRequested = true; }
        catch { error = "No se confirmó la finalización. El expediente conserva su identificador; actualice antes de reintentar."; focusErrorRequested = true; }
        finally { saving = false; }
    }

    private string selectedCategory = "";
    private string CategoryLabel => selectedCategory switch
    {
        "desktop" => "Computadora de escritorio",
        "laptop" => "Laptop",
        "monitor" => "Monitor",
        "camera" => "Cámara",
        "external-disk" => "Disco externo",
        "peripheral" => "Periférico",
        "recording" => "Equipo de grabación",
        _ => "Otro dispositivo"
    };
    private string? assetCode;
    private string? assetName;
    private CommonDraft common = new();
    private readonly Dictionary<string, TechnicalDraft> drafts = new();
    private TechnicalDraft Current => drafts.TryGetValue(selectedCategory, out var draft)
        ? draft
        : drafts[selectedCategory] = new TechnicalDraft();

    private void AddRamModule()
    {
        if (Current.RamState == "not-applicable") Current.RamState = "unrecorded";
        Current.RamModules.Add(new());
        MarkTechnicalDirty();
    }
    private void AddStorageUnit()
    {
        if (Current.StorageState == "not-applicable") Current.StorageState = "unrecorded";
        Current.StorageUnits.Add(new());
        MarkTechnicalDirty();
    }
    private void RemoveRamModule(RamDraft item)
    {
        var total = Current.EffectiveRam;
        Current.RamModules.Remove(item);
        if (Current.RamModules.Count == 0) Current.TotalRamGb = total ?? Current.TotalRamGb;
        MarkTechnicalDirty();
    }
    private void RemoveStorageUnit(StorageDraft item) { Current.StorageUnits.Remove(item); MarkTechnicalDirty(); }
    private static void HydrateTechnical(TechnicalDraft draft, EquipmentInput input)
    {
        draft.ProcessorManufacturer = input.ProcessorManufacturer; draft.ProcessorModel = input.ProcessorModel;
        draft.ProcessorName = input.ProcessorName; draft.TotalRamGb = input.TotalRamGb;
        draft.RamModulesComplete = input.RamModulesComplete ?? false; draft.ExpectedRevision = input.ExpectedTechnicalRevision;
        draft.OperatingSystem = input.OperatingSystem; draft.RamModules.Clear(); draft.StorageUnits.Clear();
        draft.RamModules.AddRange(input.RamModules.Select(x => new RamDraft { OriginalId = x.OriginalId, Capacity = x.CapacityGb }));
        draft.StorageUnits.AddRange(input.StorageUnits.Select(x => new StorageDraft { OriginalId = x.OriginalId,
            Type = x.Technology ?? "", Interface = x.Interface ?? "", Capacity = x.Capacity, Unit = x.Unit ?? "GB" }));
        draft.IsDirty = false;
    }

    private List<string> PendingChecks
    {
        get
        {
            var pending = new List<string>();
            if (common.SerialState == "pending") pending.Add("Número de serie");
            if (common.LocationState == "pending") pending.Add("Ubicación física");
            if (common.PhysicalState == "pending") pending.Add("Condición física");
            if (common.OperationalState == "pending") pending.Add("Condición operativa");
            if (!common.VerifyNow && common.VerificationState == "pending") pending.Add("Verificación técnica");
            if (selectedCategory is "desktop" or "laptop")
            {
                if (Current.RamState == "pending") pending.Add("RAM");
                if (Current.StorageState == "pending") pending.Add("Discos");
                if (Current.OsState == "pending") pending.Add("Sistema operativo");
            }
            return pending;
        }
    }

    private sealed class CommonDraft
    {
        public string? Brand { get; set; }
        public string? Model { get; set; }
        public string? Serial { get; set; }
        public string SerialState { get; set; } = "unrecorded";
        public string? Location { get; set; }
        public string LocationState { get; set; } = "unrecorded";
        public string? City { get; set; }
        public string? Inspector { get; set; }
        public string PhysicalCondition { get; set; } = "";
        public string PhysicalState { get; set; } = "unrecorded";
        public string OperationalCondition { get; set; } = "";
        public string OperationalState { get; set; } = "unrecorded";
        public bool VerifyNow { get; set; }
        public string? VerifiedBy { get; set; }
        public string VerificationState { get; set; } = "unrecorded";
    }
}
